<article class="main-content">
  <h1 class="title">
    <%= @post.title %>
  </h1>

  <div class="metadata">
    <span class="author-name"><strong><%= @user.name %></strong></span>
    <span class="divider">•</span>
    <span class="author-email"><%= @user.email %></span>
    <span class="divider">•</span>
    <span class="date"><%= @post.published_at.strftime('%d %b %Y, %H:%M') %></span>
  </div>

  <div class="description">
<%= @post.description %>
  </div>
</article>
